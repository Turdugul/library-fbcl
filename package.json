    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^3.3.1",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.5.2",
    "@types/node": "^20.8.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.16",
    "compression": "^1.8.1",
    "cssnano": "^7.1.1",
    "eslint": "^9.31.0",
    "eslint-config-next": "^15.4.3",
    "postcss": "^8.4.31",
